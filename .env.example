# ===== Flask server =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
# Angular dev server; comma-separate multiple origins
CORS_ORIGINS=http://localhost:4200

# ===== Ollama / LLM =====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
# Lower temperature for code-review discussions
REVIEW_LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=nomic-embed-text

# ===== Vector store =====
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=my_documents
RETRIEVAL_K=5

# ===== Uploads =====
UPLOAD_DIR=./uploads
MEDIA_DIR=./uploads/media
# In megabytes
MAX_UPLOAD_MB=20
WHISPER_MODEL=base

# ===== Code review service (Node.js) =====
REVIEW_SERVICE_URL=http://localhost:4000
REVIEW_TIMEOUT_SECONDS=60