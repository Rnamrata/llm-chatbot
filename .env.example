# ===== Flask server =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
# Angular dev server; comma-separate multiple origins
CORS_ORIGINS=http://localhost:4200

# ===== Ollama / LLM =====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
# Ask Lens (code-review chat): its own model, temperature 0 with a fixed seed, a larger context
# for the whole numbered file, and the longest file sent whole (in characters)
REVIEW_LLM_MODEL=qwen2.5-coder:7b
REVIEW_LLM_TEMPERATURE=0
REVIEW_LLM_SEED=42
REVIEW_NUM_CTX=16384
REVIEW_FULL_CODE_CHARS=30000
REVIEW_HISTORY_MESSAGES=8
EMBEDDING_MODEL=nomic-embed-text

# ===== Vector store =====
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=my_documents
RETRIEVAL_K=5
EMBED_BATCH_SIZE=64
EMBED_ATTEMPTS=3

# ===== Uploads =====
UPLOAD_DIR=./uploads
MEDIA_DIR=./uploads/media
# In megabytes
MAX_UPLOAD_MB=20
WHISPER_MODEL=base

# ===== Chat sessions =====
SESSIONS_FILE=./data/sessions.json

# ===== Code review service (Node.js) =====
REVIEW_SERVICE_URL=http://localhost:4000
REVIEW_TIMEOUT_SECONDS=60